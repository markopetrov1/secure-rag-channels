# Python
.venv/
__pycache__/
*.pyc

# Local model store (50 GB of weights; pull them with scripts/setup_models.sh)
ollama-models/

# Corpora and derived indices are NOT redistributed. The ISO-aligned corpus
# draws on CC BY-NC-SA community material and ISO Annex A control titles, and
# ObliQA ships without a licence file, so this repository releases the build
# scripts and a source manifest instead of the text. Rebuild with
# scripts/build_corpora.sh.
data/raw/
data/processed/*_corpus.jsonl
data/processed/obliqa_*.jsonl
data/index/
corpus/ISO27k-Toolkit/
corpus/nist/
corpus/iso27000/
corpus/annexa_hf/

# Third-party graph store, rebuilt from the corpus
lightrag_store/

# Run logs and build output
logs/
results/_archive_vulkan_contaminated/

# Release artefacts, rebuilt by scripts/ on demand
dist/
*.tar.gz

# Superseded token-ledger backups kept only for local auditing of the a6 purge
results/token_ledger.jsonl.bak*

# Editor and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.ipynb_checkpoints/

# ISO27K-QnA benchmark items. The dataset card claims CC BY 4.0 but the items are
# stated to derive from nine commercial exam-preparation books, so the claim is
# not the extractor's to make. Fetched by scripts/build_corpora.sh instead.
data/raw/iso27k_qna.jsonl
data/processed/iso27k_mcq.jsonl
data/processed/iso27k_open.jsonl

# benchmark, so its generations and judgments are kept locally for audit but not
results/generations/iso27k_*
results/judgments/iso27k_*
figures/*iso27k*

# The full annotation instrument, including the withdrawn benchmark items that
# are not ours to redistribute. See results/human_validation/README.md.
results/human_validation/_full/

# Stdout digests of analysis stages. Regenerated by scripts/run_analysis.sh on
# every run, so tracking them adds churn without adding evidence.
results/tables/_*.txt

# tracked.
figures/fig_breakeven_*
figures/fig_pareto_*
figures/fig_dominance.*
figures/fig_judge_agreement.*
